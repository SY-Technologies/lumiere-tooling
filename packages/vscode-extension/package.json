{
  "name": "lumiere-language-support",
  "displayName": "Lumiere Language Support",
  "description": "Syntax highlighting, compiler-backed diagnostics, and hover information for Lumiere",
  "version": "0.2.2",
  "private": true,
  "publisher": "lumiere-lang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SY-Technologies/lumiere-tooling.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Programming Languages", "Linters"],
  "activationEvents": ["onLanguage:lumiere"],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build.js",
    "test": "node --test tests/*.test.js",
    "package": "npm run build && vsce package --no-dependencies"
  },
  "contributes": {
    "languages": [{
      "id": "lumiere",
      "aliases": ["Lumiere", "lumiere"],
      "extensions": [".lum"],
      "icon": {
        "light": "./icons/lumiere-light.svg",
        "dark": "./icons/lumiere-dark.svg"
      },
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "lumiere",
      "scopeName": "source.lumiere",
      "path": "./syntaxes/lumiere.tmLanguage.json"
    }],
    "configuration": {
      "title": "Lumiere",
      "properties": {
        "lumiere.executablePath": {
          "type": "string",
          "default": "lumiere",
          "description": "Path to the Lumiere executable used for diagnostics."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.4.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  }
}
