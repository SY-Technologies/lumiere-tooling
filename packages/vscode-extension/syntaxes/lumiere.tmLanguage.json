{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Lumiere",
  "scopeName": "source.lumiere",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#types"
    },
    {
      "include": "#members"
    },
    {
      "include": "#imports"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.lumiere",
          "begin": "//",
          "end": "$"
        },
        {
          "name": "comment.block.documentation.lumiere",
          "begin": "/\\*\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.block.lumiere",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.lumiere",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.lumiere",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "constant.character.lumiere",
          "match": "'(?:[^'\\n]|\\\\.)'"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "(?<![\\p{L}\\p{N}_])(fonction)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)(?![\\p{L}\\p{N}_])",
          "captures": {
            "1": {
              "name": "storage.type.function.lumiere"
            },
            "2": {
              "name": "entity.name.function.lumiere"
            }
          }
        },
        {
          "match": "(?<![\\p{L}\\p{N}_])(classe|interface)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)(?![\\p{L}\\p{N}_])",
          "captures": {
            "1": {
              "name": "storage.type.lumiere"
            },
            "2": {
              "name": "entity.name.type.lumiere"
            }
          }
        },
        {
          "match": "(?<![\\p{L}\\p{N}_])(soit)\\s+(fixe\\s+)?([\\p{L}_][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": {
              "name": "storage.type.variable.lumiere"
            },
            "2": {
              "name": "storage.modifier.lumiere"
            },
            "3": {
              "name": "variable.other.definition.lumiere"
            }
          }
        },
        {
          "name": "variable.parameter.lumiere",
          "match": "[\\p{L}_][\\p{L}\\p{N}_]*(?=\\s*:\\s*[\\p{L}_])"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.lumiere",
          "match": "(?<![\\p{L}\\p{N}_])(?:Entier|Décimal|Decimal|Texte|Booléen|Booleen|Symbole|Rien|Liste|ListeFixe|Dictionnaire|Ensemble|Intervalle)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "entity.name.type.lumiere",
          "match": "(?<=:\\s)[\\p{L}_][\\p{L}\\p{N}_]*"
        },
        {
          "name": "entity.name.type.lumiere",
          "match": "(?<=->\\s)[\\p{L}_][\\p{L}\\p{N}_]*"
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "name": "entity.name.function.call.lumiere",
          "match": "(?<![.\\p{L}\\p{N}_])[\\p{L}_][\\p{L}\\p{N}_]*(?=\\s*\\()"
        }
      ]
    },
    "members": {
      "patterns": [
        {
          "name": "entity.name.function.call.lumiere",
          "match": "(?<=\\.)[\\p{L}_][\\p{L}\\p{N}_]*(?=\\s*\\()"
        },
        {
          "name": "variable.other.property.lumiere",
          "match": "(?<=\\.)[\\p{L}_][\\p{L}\\p{N}_]*"
        }
      ]
    },
    "imports": {
      "patterns": [
        {
          "match": "(?<![\\p{L}\\p{N}_])(importer)\\s+([\\p{L}_][\\p{L}\\p{N}_.]*)",
          "captures": {
            "1": {
              "name": "keyword.control.import.lumiere"
            },
            "2": {
              "name": "entity.name.namespace.lumiere"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.lumiere",
          "match": "(?<![\\p{L}\\p{N}_])(?:si|sinon|pour|chaque|dans|tant\\s+que|agir\\s+selon|arrêter|arreter|continuer|retourne|essayer|attraper|finalement|lancer)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "keyword.declaration.lumiere",
          "match": "(?<![\\p{L}\\p{N}_])(?:soit|fixe|fonction|classe|interface|réalise|realise|remplace|public|privé|prive)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "keyword.other.lumiere",
          "match": "(?<![\\p{L}\\p{N}_])(?:importer|comme|ici|parent|en)(?![\\p{L}\\p{N}_])"
        },
        {
          "name": "keyword.operator.word.lumiere",
          "match": "(?<![\\p{L}\\p{N}_])(?:est|et|ou|non)(?![\\p{L}\\p{N}_])"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.lumiere",
          "match": "(?<![\\p{L}\\p{N}_])(?:vrai|faux|rien)(?![\\p{L}\\p{N}_])"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.lumiere",
          "match": "(?<![\\p{L}\\p{N}_])(?:\\d+(?:\\.\\d+)?)(?![\\p{L}\\p{N}_])"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.lumiere",
          "match": "==|!=|<=|>=|->|[+\\-*/%=&|<>]"
        }
      ]
    }
  }
}
